# Copy to backend/.env.production on the host; never commit the filled file.
# This template is portable across a CPU VM/container host and Render.
APP_ENV=production
FLASK_ENV=production
FLASK_DEBUG=false
PORT=8000
SECRET_KEY=replace-with-at-least-32-random-characters

# Supabase Session pooler. Keep the password URI-encoded and TLS required.
DATABASE_URL=postgresql://replace-user:replace-password@replace-pooler-host:5432/postgres?sslmode=require
FIREBASE_PROJECT_ID=replace-project-id
FIREBASE_DATABASE_URL=https://replace-project-id-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","private_key":"replace-from-secret-manager"}
FIREBASE_AUTH_ACTION_URL=https://replace-patient-host/activate
CORS_ALLOWED_ORIGINS=https://replace-dashboard-host

DEMO_MODE=false
DEMO_IN_MEMORY=false
ALLOW_UNVERIFIED_PATIENT_DEMO=false
MAX_CONTENT_LENGTH=4000000
REPORT_UPLOAD_MAX_BYTES=4000000
TELEMETRY_MAX_CONTENT_LENGTH=16384
REALTIME_OUTBOX_POLL_SECONDS=5
REALTIME_OUTBOX_BATCH_SIZE=100
DEVICE_OFFLINE_AFTER_MINUTES=30

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_CHAT_TIMEOUT_SECONDS=60
OPENAI_CHAT_MAX_REQUESTS=12
OPENAI_CHAT_WINDOW_SECONDS=900
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# VM deployment only: a DNS hostname pointing at its public IP, no scheme/path.
API_HOST=replace-api-host
